Step 1 — Explain each shard first:

for idx_shard in \
  ".ds-active-externalauditd_sess-ds-2026.08.02-003244:26" \
  ".ds-active-externalgcp_audit_activity-ds-2026.07.11-000004:28" \
  ".ds-active-externalpowershell_scriptblock-ds-2026.08.02-001004:93" \
  ".ds-active-externalcloudtrail-ds-2026.08.02-000093:15"
do
  idx="${idx_shard%%:*}"
  shard="${idx_shard##*:}"
  echo "=== $idx shard $shard ==="
  curl -s -XGET "localhost:9200/_cluster/allocation/explain" -H 'Content-Type: application/json' -d "{
    \"index\": \"$idx\",
    \"shard\": $shard,
    \"primary\": false
  }" | jq '.unassigned_info, .allocate_explanation, .node_allocation_decisions[]?.deciders[]? | select(.decision==\"NO\")'
  echo
done


